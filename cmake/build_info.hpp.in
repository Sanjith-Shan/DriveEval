// Generated by CMake. Carries the build identity into every number the harness
// prints, so a latency figure can never be quoted without its compiler flags.
#ifndef SWITCHBACK_BUILD_INFO_HPP
#define SWITCHBACK_BUILD_INFO_HPP
namespace sb {
inline constexpr const char* kVersion = "@PROJECT_VERSION@";
inline constexpr const char* kBuildType = "@CMAKE_BUILD_TYPE@";
inline constexpr const char* kArchFlag = "@SB_ARCH_FLAG@";
inline constexpr const char* kCompiler = "@CMAKE_CXX_COMPILER_ID@ @CMAKE_CXX_COMPILER_VERSION@";
inline constexpr bool kWithOsqp = @SB_OSQP_01@;
}  // namespace sb
#endif
